local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local savedMovement = {
	WalkSpeed = 16,
	JumpPower = 50,
	AutoRotate = true
}

local frozen = false

local function getCharacter()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not rootPart then return end

	return character, humanoid, rootPart
end

local function freezeCharacter()
	local character, humanoid, rootPart = getCharacter()
	if not humanoid or not rootPart then return end
	if frozen then return end

	-- Save current movement settings
	savedMovement.WalkSpeed = humanoid.WalkSpeed
	savedMovement.JumpPower = humanoid.JumpPower
	savedMovement.AutoRotate = humanoid.AutoRotate

	-- Freeze movement
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.AutoRotate = false

	-- Stop current movement
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero

	frozen = true
end

local function unfreezeCharacter()
	local character, humanoid, rootPart = getCharacter()
	if not humanoid or not rootPart then return end

	-- Restore normal movement
	humanoid.WalkSpeed = savedMovement.WalkSpeed
	humanoid.JumpPower = savedMovement.JumpPower
	humanoid.AutoRotate = savedMovement.AutoRotate

	-- Remove leftover velocity
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero

	frozen = false

	-- Force Humanoid back to normal state
	task.defer(function()
		if humanoid and humanoid.Parent then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)
end

-- Detect Green Plate / FreeCam
RunService.Heartbeat:Connect(function()
	if _G.freeCamMode == true then
		freezeCharacter()
	else
		if frozen then
			unfreezeCharacter()
		end
	end
end)

-- Y = exit FreeCam and restore movement
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.Y then
		_G.freeCamMode = false
		unfreezeCharacter()
	end
end)

-- Character respawn protection
player.CharacterAdded:Connect(function()
	frozen = false
end)
